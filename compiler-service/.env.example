# compiler-service — Environment Variables
# Copy this file to .env and fill in real values before running locally.
# DO NOT commit .env to version control.

# ── API ──────────────────────────────────────────────────────────────────────

# Port the Express API listens on
COMPILER_API_PORT=5000

# Redis connection URL for BullMQ
REDIS_URL=redis://localhost:6379

# Service-to-service API key (§29 — Option B auth).
# All requests to /run and /jobs/:id must present X-Service-Key: <value>
# MUST be changed before production deployment.
COMPILER_SERVICE_API_KEY=change-me-before-production

# Exam environment version — used in project hash and result metadata.
# Bump this when the sandbox image or approved package versions change.
EXAM_ENV_VERSION=v1

# ── Timeouts ─────────────────────────────────────────────────────────────────

# Default timeout if client does not specify one (ms)
DEFAULT_EXECUTION_TIMEOUT_MS=60000

# Hard maximum — client requests above this are capped (ms)
# flutter analyze: typically 5–30s. 120s is generous for cold starts.
MAX_EXECUTION_TIMEOUT_MS=120000

# ── Rate limiting ─────────────────────────────────────────────────────────────

# Max RUN requests per (studentId, questionId) per minute.
# Cancel-and-replace counts against this limit (§13).
MAX_RUN_REQUESTS_PER_MINUTE=10

# ── File validation limits ────────────────────────────────────────────────────

# Maximum number of files in a submitted project
MAX_FILE_COUNT=50

# Maximum size of a single source file (bytes) — default 512 KB
MAX_FILE_SIZE_BYTES=524288

# Maximum size of a single asset file (.png, .ttf, etc.) — default 2 MB
MAX_ASSET_SIZE_BYTES=2097152

# Maximum total project size (all files combined) — default 10 MB
MAX_PROJECT_SIZE_BYTES=10485760

# Maximum file path length (characters)
MAX_PATH_LENGTH=260

# ── Worker / Sandbox ──────────────────────────────────────────────────────────

# How many sandbox containers to run simultaneously.
# Start with 2 for local Docker Desktop dev; scale to 4+ on dedicated production nodes.
EXEC_CONCURRENCY=2

# Sandbox Docker image — must match the image built from ./sandbox
# NEVER use 'latest' — pin an explicit version tag.
DOCKER_SANDBOX_IMAGE=exam-platform/flutter-sandbox:v1

# ── Sandbox resource limits ───────────────────────────────────────────────────
# These values are for flutter analyze only (RUN does not run flutter build web).
# Benchmark before tuning (§32 of the spec).

# Container memory limit (MB). tmpfs also counts against this limit (§10).
# Sized to 1024 MB so Dart Analysis Server has sufficient headroom without OOM (SIGKILL -9).
SANDBOX_MEMORY_MB=1024

# CPU limit in NanoCpus (1_000_000_000 = 1 full core)
SANDBOX_NANO_CPUS=1000000000

# PID limit — prevents fork bombs
SANDBOX_PIDS=256

# tmpfs size per mount point (MB). Two mounts: /tmp and /home/sandbox.
# Combined tmpfs usage is counted against SANDBOX_MEMORY_MB (RAM-backed).
# Total RAM impact: SANDBOX_MEMORY_MB >= SANDBOX_TMPFS_MB * 2 + flutter VM overhead
SANDBOX_TMPFS_MB=128

# ── Output limits ─────────────────────────────────────────────────────────────
# Prevent unlimited compiler output from consuming Node.js process memory (§11).
# If exceeded: container is killed, OUTPUT_LIMIT_EXCEEDED result returned.

# Maximum bytes of stdout captured per job (default 2 MB)
MAX_STDOUT_BYTES=2097152

# Maximum bytes of stderr captured per job (default 2 MB)
MAX_STDERR_BYTES=2097152
